# Copy this file to meeting-memory.ini and adjust the paths for your machine.
# The local meeting-memory.ini file is intentionally ignored by Git.

[paths]
meetings_dir = /path/to/meeting-logs
output_dir = /path/to/meeting-memory-data

# This file contains secrets after api_key or bot_token is filled in. Never
# commit the local meeting-memory.ini file. Model IDs use OpenRouter's
# provider/model form.
[openrouter]
api_key =
model = provider/model-name
# Optional; when blank, ask uses model above.
ask_model =
# Optional AI evidence reviewer. It falls back to ask_model, never to the
# extraction model above.
review_model =
# Reserved for the later independent automation-verifier phase.
review_critic_model =

# Optional Slack source. The bot must be a member of every configured channel.
# Use one channel ID per indented line, or a comma-separated list.
[slack]
bot_token =
channel_ids =
#  C0123456789
#  G0123456789
